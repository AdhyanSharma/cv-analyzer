            <div className="launch-trust-row">
              <span>React</span><span>FastAPI</span><span>PostgreSQL</span><span>Docker</span>
            </div>
          </div>

          <div className="launch-v181-visual">
            <div className="visual-backdrop-card" />
            <div className="launch-dashboard-card">
              <div className="mock-topbar">
                <div className="mock-brand"><span>CV</span><b>Recruiter Command Center</b></div>
                <div className="mock-user">AS</div>
              </div>
              <div className="mock-toolbar">
                <div>
                  <small>ACTIVE JOB</small>
                  <strong>AI Engineer</strong>
                </div>
                <span className="mock-open">OPEN</span>
              </div>
              <div className="mock-stat-row">
                <div><small>Jobs</small><b>08</b><span>active workspace</span></div>
                <div><small>Candidates</small><b>124</b><span>screened</span></div>
                <div><small>Shortlisted</small><b>18</b><span>in pipeline</span></div>
              </div>
              <div className="mock-candidate-head">
                <span>Candidate</span><span>ATS</span><span>Status</span>
              </div>
              <div className="mock-candidate-row">
                <div className="mock-person"><span>AS</span><div><b>Candidate profile</b><small>Resume v2 · exact screening file</small></div></div>
                <strong className="mock-score">82.4%</strong>
                <span className="mock-status">Shortlisted</span>
              </div>
              <div className="mock-candidate-row dim">
                <div className="mock-person"><span>RK</span><div><b>Candidate profile</b><small>Resume v1 · evidence ready</small></div></div>
                <strong className="mock-score">76.8%</strong>
                <span className="mock-status review">Reviewing</span>
              </div>
              <div className="mock-footer">
                <span>✓ Explainable</span><span>✓ Duplicate-safe</span><span>✓ Version-aware</span>
