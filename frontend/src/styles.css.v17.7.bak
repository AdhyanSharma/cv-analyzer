:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1b2430;background:#f5f7fb;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0;min-width:320px}button,input,textarea,select{font:inherit}button{cursor:pointer}.screen-center{min-height:100vh;display:grid;place-items:center;gap:12px;color:#687386}.loader{width:30px;height:30px;border:3px solid #dbe2ea;border-top-color:#1b2430;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.auth-shell{min-height:100vh;display:grid;grid-template-columns:1.05fr .95fr;background:#eef2f7}.auth-panel{padding:56px}.brand-panel{background:#151c28;color:#fff;display:flex;flex-direction:column;justify-content:center}.logo-mark{width:48px;height:48px;border-radius:14px;background:#fff;color:#151c28;display:grid;place-items:center;font-weight:900;letter-spacing:-.08em;margin-bottom:26px}.logo-mark.small{width:34px;height:34px;border-radius:10px;margin:0;background:#1b2430;color:#fff;font-size:12px}.eyebrow,.side-label,.stat-label,.section-title,.sub-label{font-size:11px;letter-spacing:.13em;font-weight:800}.eyebrow{color:#7f8ba0;margin-bottom:9px}.brand-panel .eyebrow{color:#8e9bb0}.brand-panel h1{max-width:650px;font-size:48px;line-height:1.05;margin:0 0 20px;letter-spacing:-.045em}.brand-panel p{max-width:600px;color:#bac4d2;font-size:18px;line-height:1.6;margin:0}.feature-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}.feature-row span{border:1px solid #344052;border-radius:999px;padding:9px 13px;color:#dbe2ea;font-size:13px}.form-panel{background:#fff;display:flex;flex-direction:column;justify-content:center}.tabs{display:flex;gap:4px}.tab{background:transparent;border:0;border-bottom:2px solid transparent;padding:12px 15px;color:#768194;font-weight:800}.tab.active{color:#1b2430;border-color:#1b2430}.form-panel .tabs{margin-bottom:36px}.stack{display:flex;flex-direction:column}.gap-md{gap:17px}.gap-lg{gap:22px}.field{display:flex;flex-direction:column;gap:8px;font-size:13px;font-weight:800}.field input,.field textarea,.field select{width:100%;border:1px solid #dbe2ea;border-radius:11px;padding:12px 13px;background:#fbfcfe;color:#1b2430;outline:none}.field input:focus,.field textarea:focus{border-color:#8895a8;box-shadow:0 0 0 3px #1b243010}.muted{color:#778297}.small-text{font-size:12px}.error-box,.success-box{border-radius:11px;padding:11px 13px;font-size:13px}.error-box{background:#fff0f0;color:#a23838;border:1px solid #f5c3c3}.success-box{background:#effaf2;color:#267242;border:1px solid #c6ebcf}.btn-lg{padding:14px 18px}
button.primary,.primary{background:#1b2430;color:white;border:0;border-radius:10px;padding:11px 16px;font-weight:800}button.primary:disabled{opacity:.55;cursor:not-allowed}.secondary,.ghost,.danger{border-radius:10px;padding:10px 14px;border:1px solid #dbe2ea;background:#fff;color:#1b2430;font-weight:800}.ghost{background:transparent;border-color:transparent;color:#667286}.danger{color:#a23838;border-color:#f0caca}.close{border:0;background:transparent;font-size:27px;color:#7c8798}.app-shell{min-height:100vh}.topbar{height:68px;background:#fff;border-bottom:1px solid #e4e9f0;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.topbar-left,.topbar-right{display:flex;align-items:center;gap:12px}.top-title{font-weight:900}.top-sub{font-size:11px;color:#8893a3;margin-top:2px}.api-dot{font-size:12px;color:#2c8551}.user-chip{background:#f2f5f8;border:1px solid #e6eaf0;padding:7px 10px;border-radius:999px;font-size:12px;font-weight:800}.body-grid{display:grid;grid-template-columns:250px 1fr;min-height:calc(100vh - 68px)}.sidebar{border-right:1px solid #e4e9f0;background:#fbfcfe;padding:22px 14px}.side-section{margin-bottom:30px}.side-label{color:#a2aaba;padding:0 9px;margin-bottom:8px}.side-link,.job-link{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;background:transparent;color:#687386;border-radius:10px;padding:10px 9px;margin-bottom:2px}.side-link.active,.side-link:hover,.job-link:hover,.job-link.selected{background:#eef2f7;color:#1b2430}.job-link{font-size:13px}.status-dot{width:7px;height:7px;border-radius:50%;background:#b4bfcc;flex:none}.status-dot.open{background:#3a9c61}.truncate{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.content{padding:28px 32px;max-width:1550px;width:100%;margin:auto}.page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:22px}.page-head h1{margin:0;font-size:32px;letter-spacing:-.03em}.page-head p{margin:7px 0 0;color:#748095}.head-actions{display:flex;gap:9px}.global{margin-bottom:12px}.global button{float:right;border:0;background:transparent;color:inherit;font-size:17px}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:18px}.stat-card,.job-card,.empty-state{background:#fff;border:1px solid #e4e9f0;border-radius:15px}.stat-card{padding:17px 18px}.stat-label{color:#8994a5}.stat-value{font-size:27px;font-weight:900;margin-top:6px}.job-card{overflow:hidden}.tabs.bordered{border-bottom:1px solid #e4e9f0;padding:0 12px}.count-pill{font-size:11px;background:#eef2f7;border-radius:999px;padding:2px 7px;margin-left:5px}.tab-content{padding:22px}.toolbar{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:18px}.toolbar h3{margin:0 0 5px}.toolbar p{margin:0;font-size:13px;max-width:780px}.upload-btn{position:relative;display:inline-flex;align-items:center;background:#1b2430;color:#fff;border-radius:10px;padding:11px 15px;font-weight:800;white-space:nowrap}.upload-btn input{position:absolute;inset:0;opacity:0;cursor:pointer}.upload-btn.disabled{opacity:.6}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:14px 12px;border-top:1px solid #edf0f4;font-size:13px;vertical-align:middle}th{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#929cab}.candidate-name{border:0;background:transparent;padding:0;color:#1b2430;font-weight:900}.candidate-meta{font-size:11px;color:#8b96a6;margin-top:4px}.score{font-weight:900}.score.good,.hero-number.good{color:#2f855a}.score.mid,.hero-number.mid{color:#9a6b16}.score.low,.hero-number.low{color:#b54949}.score.muted,.hero-number.muted{color:#9aa4b3}.table-wrap select{border:1px solid #dbe2ea;border-radius:8px;background:#fff;padding:7px 9px}.icon-btn{border:0;background:transparent;font-weight:800;color:#4d5a6e}.badge{display:inline-flex;padding:6px 9px;border-radius:999px;text-transform:capitalize;font-size:12px;font-weight:900;background:#eef2f7;color:#657083}.badge.open,.badge.shortlisted{background:#eaf7ee;color:#287348}.badge.hold{background:#fff7e7;color:#936718}.badge.rejected{background:#fff0f0;color:#a23838}.empty-table{text-align:center;padding:55px 20px}.empty-state{padding:70px 30px;text-align:center}.empty-state p{max-width:550px;margin:0 auto 18px;color:#778297;line-height:1.6}.empty-icon{font-size:30px;margin-bottom:10px}.empty-icon.small{font-size:23px}.jd-box{white-space:pre-wrap;background:#fafbfd;border:1px solid #e6eaf0;border-radius:12px;padding:18px;line-height:1.6;color:#394454}.settings-row{display:flex;justify-content:space-between;align-items:center;padding:16px 0;border-bottom:1px solid #edf0f4}.settings-row h3{margin:0 0 5px}.settings-row p{margin:0;font-size:13px}.danger-row{border-bottom:0;margin-top:12px}.modal-backdrop,.drawer-backdrop{position:fixed;inset:0;background:#0c121b66;z-index:20}.modal-backdrop{display:grid;place-items:center;padding:20px}.modal{width:min(680px,100%);background:#fff;border-radius:17px;padding:24px;box-shadow:0 24px 60px #0002}.modal-head,.drawer-head{display:flex;justify-content:space-between;gap:20px}.modal-head{margin-bottom:18px}.modal-head h2,.drawer-head h2{margin:0}.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:6px}.drawer-backdrop{display:flex;justify-content:flex-end}.drawer{height:100%;width:min(620px,100%);background:#fff;overflow:auto;box-shadow:-24px 0 60px #0002}.drawer-head{padding:23px;border-bottom:1px solid #e5e9ef;position:sticky;top:0;background:#fff;z-index:2}.drawer-head p{margin:7px 0 0;color:#748095}.drawer-body{padding:20px 23px}.hero-score{display:flex;align-items:center;justify-content:space-between;background:#f7f9fc;border:1px solid #e6eaf0;border-radius:14px;padding:18px;margin-bottom:18px}.hero-number{font-size:42px;font-weight:950;letter-spacing:-.05em;margin-top:3px}.drawer-section{padding:19px 0;border-bottom:1px solid #edf0f4}.drawer-section:last-child{border-bottom:0}.section-title{margin-bottom:13px;color:#5f6b7c}.score-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.mini-score{border:1px solid #e8ebf0;border-radius:11px;padding:11px}.mini-score span{font-size:12px;color:#718097;display:block}.mini-score b{display:block;margin-top:5px;font-size:19px}.meter{height:5px;background:#e9edf2;border-radius:999px;overflow:hidden;margin-top:9px}.meter i{display:block;height:100%;background:#1b2430;border-radius:999px}.tag-group{display:flex;flex-wrap:wrap;gap:7px}.tag{padding:7px 9px;background:#f0f3f7;border:1px solid #e2e7ed;border-radius:999px;font-size:12px}.tag.success{background:#eef9f1;border-color:#cee9d5;color:#287348}.tag.danger-tag{background:#fff1f1;border-color:#f0d0d0;color:#a23838}.sub-label{color:#929bab;margin:14px 0 8px}.coverage-block + .coverage-block{margin-top:15px}.evidence-list{display:grid;gap:9px}.evidence{background:#fafbfd;border-left:3px solid #cbd3de;padding:10px 12px;color:#515d6e;line-height:1.5;font-size:13px}.info-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;font-size:13px}.info-row span{color:#8994a5}.info-row b{text-align:right;overflow-wrap:anywhere;max-width:65%}
@media(max-width:1000px){.auth-shell{grid-template-columns:1fr}.brand-panel{display:none}.body-grid{grid-template-columns:1fr}.sidebar{display:none}.content{padding:20px}.stats-grid{grid-template-columns:1fr 1fr}.page-head{align-items:flex-start;flex-direction:column}.toolbar{align-items:flex-start;flex-direction:column}}@media(max-width:640px){.topbar{padding:0 12px}.topbar-right .api-dot,.top-sub{display:none}.content{padding:14px}.stats-grid{grid-template-columns:1fr 1fr}.page-head h1{font-size:26px}.score-grid{grid-template-columns:1fr}.auth-panel{padding:28px}.info-row{flex-direction:column}.info-row b{text-align:left;max-width:100%}}

.resume-version-list{display:flex;flex-direction:column;gap:10px}.resume-version{border:1px solid rgba(127,127,127,.18);border-radius:12px;padding:12px 14px;background:rgba(127,127,127,.04)}.resume-version.current{border-color:rgba(80,140,255,.35);background:rgba(80,140,255,.06)}.resume-version-main{display:flex;align-items:center;gap:12px}.resume-version-number{min-width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;background:rgba(127,127,127,.10)}.resume-version-info{flex:1;min-width:0}.resume-version-name{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.resume-version-date{margin-top:3px;font-size:12px;color:var(--muted)}.resume-version .badge{flex-shrink:0}.screened-resume{margin-bottom:14px;padding:14px;border:1px solid rgba(80,140,255,.30);border-radius:12px;background:rgba(80,140,255,.07)}.screened-resume-label{font-size:10px;font-weight:800;letter-spacing:.08em;margin-bottom:8px;color:var(--muted)}.screened-resume-main{display:flex;align-items:center;gap:12px}.screened-resume-version{width:42px;height:42px;flex-shrink:0;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;background:rgba(80,140,255,.14)}.screened-resume-name{font-weight:700;word-break:break-word}.screened-resume-sub{margin-top:4px;font-size:12px;color:var(--muted);line-height:1.4}.resume-comparison{margin-top:14px;padding-top:14px;border-top:1px solid rgba(127,127,127,.15)}.compare-controls{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto;gap:8px;align-items:center;margin-top:8px}.compare-controls select{min-width:0}.compare-arrow{color:var(--muted);font-weight:800}.comparison-panel{margin-top:12px;padding:14px;border:1px solid rgba(127,127,127,.18);border-radius:12px;background:rgba(127,127,127,.04)}.comparison-header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.comparison-files{max-width:52%;display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end;font-size:11px;color:var(--muted)}.comparison-ats{display:flex;align-items:center;justify-content:center;gap:18px;margin:16px 0}.comparison-ats>div:not(.comparison-arrow):not(.comparison-change){display:flex;flex-direction:column;align-items:center;gap:3px}.comparison-ats span{font-size:11px;color:var(--muted)}.comparison-ats b{font-size:22px}.comparison-change{font-weight:800;font-size:14px}.comparison-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.comparison-list{min-width:0}.comparison-list .tag{margin-bottom:6px}.candidate-version-meta{margin-top:3px;font-size:11px;font-weight:700;color:var(--muted)}@media (max-width:700px){.compare-controls{grid-template-columns:1fr}.compare-arrow{display:none}.comparison-header{flex-direction:column}.comparison-files{max-width:100%;justify-content:flex-start}.comparison-grid{grid-template-columns:1fr}}

.v14-notice{background:#f4f7fb;border:1px solid #e1e7ef;border-radius:12px;padding:12px 14px;margin-bottom:16px;color:#556276;font-size:13px;line-height:1.5}.v14-tabs{margin-bottom:0}.job-picker{border:1px solid #dbe2ea;border-radius:10px;background:#fff;padding:10px 12px;color:#1b2430;font-weight:800;min-width:220px}.v14-panel{background:#fff;border:1px solid #e4e9f0;border-radius:15px;overflow:hidden}.evaluation-controls{padding:20px 22px;border-bottom:1px solid #edf0f4;display:flex;justify-content:space-between;align-items:center;gap:20px}.threshold-control{display:flex;align-items:center;gap:8px}.threshold-control input{width:85px;border:1px solid #dbe2ea;border-radius:9px;padding:10px}.threshold-control button{margin-left:6px}.metric-grid-v14{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;padding:18px}.metric-grid-v14 .stat-card{min-width:0}.confusion{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:0 18px 18px}.confusion>div{border:1px solid #e8ebf0;border-radius:11px;padding:12px}.confusion span{display:block;color:#7a8698;font-size:12px}.confusion b{display:block;margin-top:5px;font-size:20px}.run-list{display:grid;gap:9px}.run-row{display:flex;justify-content:space-between;gap:15px;padding:11px 12px;background:#fafbfd;border:1px solid #e8ebf0;border-radius:10px;font-size:12px}.audit-list{display:grid}.audit-row{display:flex;justify-content:space-between;gap:20px;padding:14px 18px;border-top:1px solid #edf0f4}.audit-meta{display:flex;flex-direction:column;gap:5px;align-items:flex-end;color:#8994a5;font-size:11px}.audit-meta code{max-width:520px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#f7f9fc;padding:3px 6px;border-radius:5px;color:#627085}@media(max-width:1000px){.metric-grid-v14{grid-template-columns:repeat(3,1fr)}.evaluation-controls{align-items:flex-start;flex-direction:column}.audit-row{flex-direction:column}.audit-meta{align-items:flex-start}}@media(max-width:640px){.metric-grid-v14{grid-template-columns:1fr 1fr}.confusion{grid-template-columns:1fr 1fr}.threshold-control{flex-wrap:wrap}.job-picker{min-width:0;width:100%}}


/* =========================================================
   V17.7 UI REFRESH + LAUNCH PAGE
   ========================================================= */
:root{
  --ink:#172033;
  --muted:#748096;
  --line:#e4e9f1;
  --panel:#ffffff;
  --soft:#f6f8fc;
  --accent:#6d5dfc;
  --accent-2:#20b6a8;
  --shadow:0 18px 55px rgba(29,40,66,.10);
}

button{transition:transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease}
button:not(:disabled):hover{transform:translateY(-1px)}

/* Launch page */
.launch-page{min-height:100vh;background:radial-gradient(circle at 15% 15%,#2d3b8140,transparent 28%),radial-gradient(circle at 84% 12%,#1fc7b040,transparent 25%),linear-gradient(135deg,#0d1424 0%,#101a31 48%,#12182b 100%);color:#fff;position:relative;overflow:hidden}
.launch-page:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 0%,rgba(255,255,255,.03) 45%,transparent 70%);pointer-events:none}
.launch-orb{position:absolute;border-radius:50%;filter:blur(30px);pointer-events:none}
.launch-orb-one{width:340px;height:340px;right:-120px;top:180px;background:#6d5dfc33}
.launch-orb-two{width:280px;height:280px;left:-100px;bottom:30px;background:#20b6a833}
.launch-nav{width:min(1240px,calc(100% - 40px));margin:0 auto;padding:24px 0;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:2}
.launch-brand{display:flex;align-items:center;gap:12px}
.launch-logo{width:42px;height:42px;margin:0;background:rgba(255,255,255,.96);color:#151b2b;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.18)}
.launch-brand-name{font-weight:900;letter-spacing:-.02em;font-size:15px}
.launch-brand-sub{font-size:11px;color:#9eabc0;margin-top:2px}
.launch-nav-actions{display:flex;align-items:center;gap:12px}
.launch-status{display:flex;align-items:center;gap:7px;color:#b7c3d7;font-size:12px}
.launch-status i{width:7px;height:7px;background:#5be1b2;border-radius:50%;box-shadow:0 0 0 5px #5be1b215}
.launch-nav-button{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.13);color:#fff;border-radius:11px;padding:10px 15px;font-weight:800}
.launch-content{width:min(1240px,calc(100% - 40px));margin:0 auto;position:relative;z-index:2}
.launch-hero{min-height:620px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:45px;padding:54px 0 38px}
.launch-kicker{display:flex;align-items:center;gap:9px;font-size:11px;letter-spacing:.15em;font-weight:900;color:#97a4bb}
.launch-kicker b{letter-spacing:.04em;background:#ffffff12;border:1px solid #ffffff14;padding:5px 8px;border-radius:999px;color:#dbe4f2}
.launch-hero h1{font-size:clamp(44px,6vw,76px);line-height:.98;letter-spacing:-.055em;max-width:700px;margin:18px 0 22px}
.launch-hero h1 span{color:#8ee9db}
.launch-subtitle{max-width:650px;color:#adbacf;font-size:17px;line-height:1.7;margin:0}
.launch-cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.launch-primary{border:0;border-radius:12px;padding:14px 18px;background:linear-gradient(135deg,#7668ff,#5b82ff);color:#fff;font-weight:900;box-shadow:0 15px 35px #5f74ff3b}
.launch-primary span{margin-left:7px}
.launch-primary.compact{padding:12px 16px}
.launch-secondary{border:1px solid #ffffff1c;border-radius:12px;padding:14px 17px;background:#ffffff08;color:#e8eef9;font-weight:800}
.launch-tech-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px;color:#8795ab;font-size:11px}
.launch-tech-row span{padding:7px 9px;border:1px solid #ffffff10;border-radius:999px;background:#ffffff05}
.launch-preview{position:relative}
.preview-glow{position:absolute;inset:10% -4% -8%;background:linear-gradient(135deg,#6d5dfc35,#20b6a835);filter:blur(45px);border-radius:50%}
.preview-window{position:relative;background:#f7f9fc;border:1px solid #ffffff1c;border-radius:22px;padding:11px;box-shadow:0 30px 80px rgba(0,0,0,.30);transform:perspective(1100px) rotateY(-5deg) rotateX(2deg)}
.preview-topbar{height:32px;display:grid;grid-template-columns:70px 1fr 28px;align-items:center;gap:10px;padding:0 9px}
.preview-dots{display:flex;gap:5px}.preview-dots i{width:6px;height:6px;border-radius:50%;background:#c9d0db}
.preview-url{justify-self:center;border:1px solid #e1e6ee;background:#fff;border-radius:7px;padding:4px 18px;color:#8e9aae;font-size:9px}
.preview-live{color:#43aa79;font-size:10px;justify-self:end}
.preview-body{min-height:380px;display:grid;grid-template-columns:82px 1fr;background:#fff;border:1px solid #e7ebf1;border-radius:15px;overflow:hidden}
.preview-side{background:#f7f8fb;padding:13px 8px;display:flex;flex-direction:column;gap:7px}
.preview-mark{width:28px;height:28px;border-radius:8px;background:#172033;color:#fff;display:grid;place-items:center;font-size:9px;font-weight:900;margin-bottom:12px}
.preview-side-pill{font-size:8px;color:#8b95a6;padding:8px 6px;border-radius:7px}.preview-side-pill.active{background:#eaebff;color:#5448c8;font-weight:800}
.preview-main{padding:18px}
.preview-heading{display:flex;justify-content:space-between;align-items:flex-start}.preview-heading small{display:block;color:#9aa3b2;font-size:8px;letter-spacing:.11em;font-weight:900}.preview-heading strong{display:block;margin-top:5px;font-size:18px;color:#1a2333}
.preview-chip{font-size:9px;font-weight:800;padding:5px 8px;border-radius:999px;background:#eaf7ef;color:#347853}
.preview-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:18px}.preview-metrics div{border:1px solid #edf0f4;border-radius:9px;padding:9px;background:#fbfcfe}.preview-metrics small{display:block;font-size:8px;color:#9aa4b2}.preview-metrics b{display:block;font-size:17px;margin-top:4px;color:#1b2430}
.preview-candidate{display:flex;align-items:center;gap:10px;border:1px solid #e8ecf2;border-radius:11px;padding:10px;margin-top:14px}.preview-avatar{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#1d2840,#6576ff);color:#fff;display:grid;place-items:center;font-size:8px;font-weight:900}.preview-candidate-main{flex:1}.preview-candidate-main b{display:block;color:#243043;font-size:10px}.preview-candidate-main small{color:#9aa5b5;font-size:8px;margin-top:3px;display:block}.preview-score{display:flex;flex-direction:column;align-items:flex-end}.preview-score small{color:#9aa4b2;font-size:8px}.preview-score b{color:#2b815d;font-size:14px;margin-top:2px}.preview-lines{margin-top:15px;display:grid;gap:7px}.preview-lines i{height:6px;background:linear-gradient(90deg,#ebeff5 0 68%,transparent 68%);border-radius:999px}.preview-lines i:nth-child(2){background:linear-gradient(90deg,#ebeff5 0 84%,transparent 84%)}.preview-lines i:nth-child(3){background:linear-gradient(90deg,#ebeff5 0 52%,transparent 52%)}.preview-lines i:nth-child(4){background:linear-gradient(90deg,#ebeff5 0 74%,transparent 74%)}
.launch-highlights{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:10px 0 70px}
.launch-feature{display:flex;gap:13px;padding:18px;border:1px solid #ffffff10;background:#ffffff06;border-radius:15px;min-height:128px}.launch-feature-icon{width:34px;height:34px;flex:none;border-radius:10px;background:linear-gradient(135deg,#ffffff18,#ffffff08);display:grid;place-items:center;color:#9de8dd;font-weight:900}.launch-feature h3{font-size:13px;margin:2px 0 5px}.launch-feature p{font-size:11px;line-height:1.55;color:#94a2b7;margin:0}
.launch-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 0 55px;border-top:1px solid #ffffff10}.launch-mini-label{font-size:10px;letter-spacing:.14em;font-weight:900;color:#7f8da5}.launch-bottom h2{max-width:720px;margin:8px 0 0;font-size:27px;letter-spacing:-.03em}
.auth-back{align-self:flex-start;border:0;background:transparent;color:#768194;font-size:12px;font-weight:800;padding:0;margin-bottom:18px}

/* Dashboard refresh */
.topbar{height:72px;padding:0 26px;background:rgba(255,255,255,.92);backdrop-filter:blur(14px);box-shadow:0 1px 0 #e7ebf2}.logo-mark.small{box-shadow:0 6px 18px rgba(28,38,58,.12)}
.top-title{letter-spacing:-.02em}.top-sub{letter-spacing:.01em}
.body-grid{grid-template-columns:255px 1fr;background:#f6f8fc;min-height:calc(100vh - 72px)}
.sidebar{padding:24px 15px;background:linear-gradient(180deg,#fbfcfe,#f6f8fc);border-right:1px solid #e7ebf0}
.side-section{margin-bottom:28px}.side-label{font-size:10px;letter-spacing:.15em}.side-link,.job-link{transition:all .15s ease}.side-link.active,.side-link:hover,.job-link:hover,.job-link.selected{box-shadow:0 6px 18px #22304c0a}
.content{padding:34px 36px 48px;max-width:1520px}.page-head{margin-bottom:18px}.page-head h1{font-size:36px}.page-head p{font-size:13px}
.stats-grid{gap:14px;margin-bottom:15px}.stat-card{border-color:#e6eaf0;box-shadow:0 8px 22px #26365708}.stat-card:hover{box-shadow:0 12px 30px #26365710}.stat-value{letter-spacing:-.03em}
.workspace-strip{display:flex;align-items:center;gap:12px;border:1px solid #e1e5ff;background:linear-gradient(135deg,#f7f6ff,#f4fbfa);padding:12px 14px;border-radius:13px;margin-bottom:16px}.workspace-strip-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:9px;background:#6d5dfc12;color:#6657ea}.workspace-strip strong{font-size:12px;display:block}.workspace-strip span{font-size:11px;color:#7f8998;display:block;margin-top:3px}.workspace-strip-badge{margin-left:auto;padding:5px 8px!important;border-radius:999px;background:#fff;color:#6a7382!important;border:1px solid #e5e9f0;font-weight:900;letter-spacing:.06em}
.job-card,.v14-panel{box-shadow:0 12px 34px #26365708}.tabs.bordered{padding:0 14px}.tab{padding:13px 14px}.tab.active{color:#5c51d7;border-color:#6658e9}
.toolbar{margin-bottom:16px}.toolbar h3{font-size:16px}.toolbar p{line-height:1.55}
.upload-btn{background:linear-gradient(135deg,#1b2430,#2a3750);box-shadow:0 9px 22px #18223819}.table-wrap{border:1px solid #edf0f4;border-radius:12px}.table-wrap table{background:#fff}.table-wrap tr:hover td{background:#fbfcff}.candidate-name:hover{color:#5f52db}.row-actions{display:flex;gap:8px;justify-content:flex-end;align-items:center}.compare-action{padding:8px 10px;font-size:12px}.candidate-table-shell{display:flex;flex-direction:column;gap:12px}.candidate-tools{display:flex;gap:9px;align-items:center;justify-content:space-between}.candidate-search{display:flex;align-items:center;gap:8px;min-width:0;flex:1;border:1px solid #dfe5ed;background:#fff;border-radius:10px;padding:0 11px}.candidate-search span{font-size:19px;color:#9ca6b6}.candidate-search input{border:0;outline:0;background:transparent;width:100%;padding:10px 0;font-size:13px}.status-filter{border:1px solid #dfe5ed;border-radius:10px;background:#fff;padding:10px 12px;color:#495567;font-weight:700}.compact-empty{padding:38px 20px!important}
.modal{box-shadow:0 30px 80px rgba(22,30,49,.18)}.modal-backdrop,.drawer-backdrop{backdrop-filter:blur(4px)}.drawer{box-shadow:-30px 0 70px rgba(22,30,49,.18)}.drawer-head{box-shadow:0 3px 12px #25355308}.hero-score{background:linear-gradient(135deg,#f8f9ff,#f5faf9);box-shadow:0 8px 25px #26365708}
.resume-version{transition:transform .15s ease,box-shadow .15s ease}.resume-version:hover{transform:translateY(-1px);box-shadow:0 8px 20px #2636570c}
.comparison-panel{background:linear-gradient(135deg,#fafaff,#f8fbfb)}

@media(max-width:1050px){.launch-hero{grid-template-columns:1fr;padding-top:30px}.launch-preview{max-width:760px;margin:0 auto}.launch-highlights{grid-template-columns:1fr 1fr}.launch-bottom{flex-direction:column;align-items:flex-start}.content{padding:26px 22px}.candidate-tools{align-items:stretch;flex-direction:column}.candidate-search{width:100%}.status-filter{width:100%}}
@media(max-width:700px){.launch-nav,.launch-content{width:min(100% - 24px,1240px)}.launch-nav{padding:17px 0}.launch-status{display:none}.launch-hero{min-height:auto;padding:38px 0 28px}.launch-hero h1{font-size:46px}.launch-subtitle{font-size:15px}.launch-highlights{grid-template-columns:1fr;padding-bottom:45px}.launch-bottom h2{font-size:22px}.preview-window{transform:none}.preview-body{grid-template-columns:64px 1fr}.preview-main{padding:13px}.preview-metrics{gap:5px}.preview-metrics b{font-size:14px}.topbar{padding:0 13px}.content{padding:18px 12px 35px}.page-head h1{font-size:28px}.workspace-strip-badge{display:none}.stats-grid{grid-template-columns:1fr 1fr}.table-wrap{border-radius:11px}.drawer{width:100%}.compare-controls{grid-template-columns:1fr}.compare-arrow{display:none}}
